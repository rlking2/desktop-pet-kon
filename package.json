{
  "name": "dsh-desktop-pet",
  "version": "0.1.0",
  "private": true,
  "description": "桌宠 —— 透明无边框置顶 + 逐像素鼠标穿透 + 帧动画素材管线 + 自动自检",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:debug": "node scripts/start-debug.js",
    "autotest": "node scripts/autotest.js",
    "inspect": "node scripts/inspect-image.js",
    "assets": "node scripts/inspect-assets.js",
    "assets:write": "node scripts/inspect-assets.js --write",
    "fixtures": "node scripts/make-test-assets.js",
    "probe:clickthrough": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/probe-clickthrough.ps1",
    "verify": "npm run autotest && npm run inspect"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron": "^44.4.5"
  }
}
